
# Toggle MSW-style in-app mock API.
# When true, /api/* is handled by the front-end Route Handlers in src/app/api,
# instead of being proxied to the NestJS backend.
NEXT_PUBLIC_USE_MOCK=true

# Public-facing base path of the backend API. The frontend always calls /api/*
# through Next.js, so this is only used by next.config.js for the proxy rewrite.
API_BASE_URL=http://localhost:4000
